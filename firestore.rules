rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if current user is designated Super Admin (+918248843385)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.phone_number == '+918248843385' ||
        request.auth.token.phone_number == '8248843385' ||
        request.auth.token.email == 'admin@landsellingapp.com' ||
        request.auth.token.admin == true
      );
    }

    // -------------------------------------------------------------
    // USERS COLLECTION (/users/{userId})
    // -------------------------------------------------------------
    // Stores user profile, phone, address, location, role, and PIN.
    // Document ID: usr_{10_digit_phone} or Firebase UID.
    match /users/{userId} {
      // Allow reading so buyer/seller contact details and admin dashboard work smoothly
      allow read: if true;

      // Allow registration, PIN login sync, and profile/location updates
      allow create, update: if true;

      // Account deletion permitted for the user themselves or Admin
      allow delete: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

    // -------------------------------------------------------------
    // PROPERTIES COLLECTION (/properties/{propertyId})
    // -------------------------------------------------------------
    // Land, plots, and commercial listings
    match /properties/{propertyId} {
      // Anyone can browse land/plot listings
      allow read: if true;

      // Allow creating and updating property listings
      allow create, update: if true;

      // Deletion permitted for authenticated owners or Admin
      allow delete: if isAuthenticated() || isAdmin();
    }

    // -------------------------------------------------------------
    // INQUIRIES & CONTACT REQUESTS (/inquiries & /contactRequests)
    // -------------------------------------------------------------
    // Buyer inquiries and contact seller requests
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /contactRequests/{requestId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // FAVORITES / SHORTLIST (/favorites/{favoriteId})
    // -------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // COMPLAINTS & REVIEWS (/complaints & /reviews)
    // -------------------------------------------------------------
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // FALLBACK FOR OTHER COLLECTIONS
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
